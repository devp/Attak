[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = false

[libraries]

; Godot builds these tags as "<os>.<debug|release>.<arch>", where arch uses
; Engine.get_architecture_name() -- "arm64", not "arm64-v8a".
;
; Only arm64 is provided for Android on purpose: the Android arm64 preset drops
; armeabi-v7a, since a 32-bit device would otherwise get Godot's armv7 template
; libs with no matching extension library and fail to load it.
linux.debug.x86_64 = "res://addons/taktician/bin/libattak_taktician.linux.x86_64.so"
linux.release.x86_64 = "res://addons/taktician/bin/libattak_taktician.linux.x86_64.so"
android.debug.arm64 = "res://addons/taktician/bin/libattak_taktician.android.arm64.so"
android.release.arm64 = "res://addons/taktician/bin/libattak_taktician.android.arm64.so"

[dependencies]

; The Go half of the engine. Only Android needs this entry: Go cannot build a
; c-archive for android (see native/build.rs), so there the engine is a second
; shared library rather than statically linked in, and Godot has to be told to
; package it.
;
; Godot tags a dependency with the dot-separated parts of its key and matches
; those against the ABI list, so "arm64" here is what lands the file in the APK's
; lib/arm64-v8a/ -- next to the extension, where the dynamic linker resolves it
; with no rpath needed.
;
; The filename must stay exactly libtaktician.so: Godot packages a dependency
; under its own basename, and that is the DT_NEEDED the extension was linked
; with. Only one of these two keys is ever matched, since debug and release are
; mutually exclusive features.
android.debug.arm64 = { "res://addons/taktician/bin/libtaktician.so" : "" }
android.release.arm64 = { "res://addons/taktician/bin/libtaktician.so" : "" }
